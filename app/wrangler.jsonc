{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-curator",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-08",
  "observability": {
    "enabled": true
  },
  "triggers": {
    // 21:00 UTC=朝6時JST に日次パス(取得〜要約を単一パスで実行)を1回走らせる
    "crons": ["0 21 * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-curator-db",
      "database_id": "c051d5fa-0e99-4c6b-8961-d5d2c792f901"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG",
      "id": "04a1885ee0e1421d8ccce689acace6c9"
    }
  ]
}
