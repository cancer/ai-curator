{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-curator",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-08",
  "observability": {
    "enabled": true
  },
  "triggers": {
    // 3時間ごと=Cron A(fetch) / 21:00 UTC=朝6時JST=Cron B(feed構築)
    "crons": ["0 */3 * * *", "0 21 * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "d1_databases": [
    {
      "binding": "DB",
      // タスク10で `wrangler d1 create` の結果を記入する(プレースホルダ)
      "database_name": "ai-curator-db",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG",
      // タスク10で `wrangler kv namespace create` の結果を記入する(プレースホルダ)
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ]
}
