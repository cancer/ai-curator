{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ai-curator",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-08",
  "observability": {
    "enabled": true
  },
  "triggers": {
    // 21:00 UTC=朝6時JST に日次パスの Workflow インスタンスを1回起動する（実行は Workflow）
    "crons": ["0 21 * * *"]
  },
  "ai": {
    "binding": "AI"
  },
  "workflows": [
    {
      // 日次パス(取得〜要約)。scheduled/手動どちらも create するだけで、実行は Workflow。
      "name": "ai-curator-daily",
      "binding": "DAILY_PASS",
      "class_name": "DailyPass"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ai-curator-db",
      "database_id": "c051d5fa-0e99-4c6b-8961-d5d2c792f901"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG",
      "id": "04a1885ee0e1421d8ccce689acace6c9"
    }
  ]
}
